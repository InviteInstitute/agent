# Copy to .env and fill in. Everything the server reads is listed in server/agent/config.py
# and the modules that use it.

POSTGRES_PASSWORD=change-me

# Which coding environments this site serves, by id: vexcode-vr, zany
ENVIRONMENTS=vexcode-vr
# The 3D tutor shows once a Unity build is installed in avatar/build (see avatar/README.md).
# Its voice: af_heart, am_puck, bf_isabella or bm_fable, and its pace
# TTS_VOICE=af_heart
# TTS_SPEED=1.0
# Spoken questions: the speech-to-text model the LLM endpoint serves. Empty turns the mic off.
# TRANSCRIBE_MODEL=granite-speech-4.1-2b-plus

# The LLM: any OpenAI-compatible endpoint. Production uses NCSA Lumen, whose key the INVITE
# server keeps in /etc/lumen.env. For local work, Ollama serves one at http://localhost:11434/v1
OPENAI_BASE_URL=https://lumen.ncsa.illinois.edu/v1
OPENAI_API_KEY=
NAVIGATOR_MODEL=qwen3.8-27b
# LLM_TIMEOUT_S=30

# VEXcode VR's logs come from the Invite Institute Hub: a token, or a login to get one
INVITE_HUB_BASE_URL=https://inviteinstitutehub.org
INVITE_HUB_TOKEN=
INVITE_HUB_USERNAME=
INVITE_HUB_PASSWORD=
# ZANY's logs come from ATLAS-invite's log store, read-only as agent_reader. On the INVITE server
# this is in /etc/agent/zany.env
# ZANY_LOG_DSN=postgresql://agent_reader:...@/zany?host=/var/run/postgresql
# How far back a fresh database's first sync reaches, in hours
# STUDENT_RECENCY_HOURS=24

# Proactive check-ins: the daemon messages real students, so turning it on is deliberate.
# It reads every environment's logs and looks at each student with recent events.
CHECKINS_ENABLED=false
# Trigger types it still detects and keeps but does not act on, e.g. inactive,explorer
# TRIGGER_DISABLED=
# CHECKIN_INTERVAL_S=5
# CHECKIN_IDLE_MAX_S=30

# The Turnstile gate: Cloudflare's secret, and a long random value that signs the cookie
TURNSTILE_SECRET=
SESSION_SECRET=
# LLM tokens a browser session may spend, and the whole site in a day
# LLM_SESSION_TOKEN_LIMIT=150000
# LLM_DAILY_TOKEN_LIMIT=3000000

# The API's port on 127.0.0.1, where nginx reaches it
# API_PORT=8005
# Where Postgres keeps its files: a named volume unless set. Production uses /data/agent/postgres
# DB_DATA=/data/agent/postgres
